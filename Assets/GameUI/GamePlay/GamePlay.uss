.gameplay-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background-color: #161616;
}

.game-card {
    width: 720px;
    max-width: 92%;
    padding: 24px;
    border-radius: 22px;
    background-color: #f4f1ea;
    border-width: 4px;
    border-color: #2b2b2b;
}

.top-bar {
    margin-bottom: 18px;
}

.title-label {
    -unity-font-style: bold;
    font-size: 34px;
    color: #1f1f1f;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
    letter-spacing: 2px;
}

.stats-row {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.stat-label {
    font-size: 15px;
    color: #333333;
    -unity-font-style: bold;
    margin-left: 10px;
    margin-right: 10px;
}

.board-container {
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
}

.sudoku-board {
    width: 456px;
    height: 456px;
    background-color: #111111;
    border-width: 3px;
    border-color: #111111;
    flex-direction: row;
    flex-wrap: wrap;
}

.sudoku-cell {
    width: 50px;
    height: 50px;
    min-width: 50px;
    min-height: 50px;
    max-width: 50px;
    max-height: 50px;

    margin: 0;
    padding: 0;

    background-color: #ffffff;
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: #aaaaaa;

    color: #222222;
    -unity-font-style: bold;
    font-size: 22px;
    -unity-text-align: middle-center;
}

.sudoku-cell.box-right {
    border-right-width: 3px;
    border-right-color: #111111;
}

.sudoku-cell.box-bottom {
    border-bottom-width: 3px;
    border-bottom-color: #111111;
}

.sudoku-cell {
    -unity-text-align: middle-center;
}

.number-pad {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 14px;
}

.number-button {
    width: 52px;
    height: 44px;
    margin: 4px;
    border-radius: 12px;
    background-color: #ffffff;
    color: #222222;
    border-width: 2px;
    border-color: #333333;
    unity-font-style: bold;
    font-size: 18px;
}

.number-button:hover {
    background-color: #e7e2d7;
}

.number-button.number-complete {
    background-color: #d8d8d8;
    border-color: #b8b8b8;
    color: #777777;
}

.number-button.number-complete:hover {
    background-color: #d8d8d8;
}

.action-buttons {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.secondary-button {
    width: 130px;
    height: 44px;
    margin: 4px;
    border-radius: 14px;
    background-color: #ffffff;
    color: #222222;
    border-width: 2px;
    border-color: #333333;
    -unity-font-style: bold;
    font-size: 15px;
}

.secondary-button:hover {
    background-color: #e7e2d7;
}
.related-cell {
    background-color: #f0f0f0;
}

.matching-cell {
    background-color: #dedede;
}

.selected-cell {
    background-color: #d2d2d2;
    border-left-width: 3px;
    border-top-width: 3px;
    border-left-color: #444444;
    border-top-color: #444444;
}

.given-cell {
    color: #111111;
    unity-font-style: bold;
}

.correct-cell {
    color: #1b4332;
    background-color: #e8f5e9;
}

.wrong-cell {
    color: #8a1c1c;
    background-color: #ffe5e5;
}

.notes-cell {
    font-size: 12px;
    color: #666666;
    -unity-font-style: bold;
    white-space: normal;
}

.active-button {
    background-color: #222222;
    color: #ffffff;
    border-color: #222222;
}

.pause-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(22, 22, 22, 0.92);
}

.pause-card {
    width: 360px;
    max-width: 88%;
    padding: 28px;
    border-radius: 22px;
    background-color: #f4f1ea;
    border-width: 4px;
    border-color: #2b2b2b;
}

.pause-title {
    -unity-font-style: bold;
    font-size: 32px;
    color: #1f1f1f;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
    letter-spacing: 2px;
}

.pause-text {
    font-size: 15px;
    color: #555555;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.board-paused {
    visibility: hidden;
}

.hidden {
    display: none;
}

/* Dark theme */

.dark-theme .gameplay-root {
    background-color: #101010;
}

.dark-theme .game-card {
    background-color: #1f1f1f;
    border-color: #eeeeee;
}

.dark-theme .title-label {
    color: #eeeeee;
}

.dark-theme .stat-label {
    color: #dddddd;
}

.dark-theme .sudoku-board {
    background-color: #eeeeee;
    border-color: #eeeeee;
}

.dark-theme .sudoku-cell {
    background-color: #222222;
    color: #eeeeee;
    border-color: #555555;
}

.dark-theme .sudoku-cell.box-right {
    border-right-color: #eeeeee;
}

.dark-theme .sudoku-cell.box-bottom {
    border-bottom-color: #eeeeee;
}

.dark-theme .related-cell {
    background-color: #2d2d2d;
}

.dark-theme .matching-cell {
    background-color: #3a3a3a;
}

.dark-theme .selected-cell {
    background-color: #444444;
    border-left-color: #dddddd;
    border-top-color: #dddddd;
}

.dark-theme .given-cell {
    color: #ffffff;
}

.dark-theme .correct-cell {
    color: #b7f7c0;
    background-color: #18351d;
}

.dark-theme .wrong-cell {
    color: #ffb4b4;
    background-color: #421d1d;
}

.dark-theme .notes-cell {
    color: #bbbbbb;
}

.dark-theme .number-button,
.dark-theme .secondary-button {
    background-color: #252525;
    color: #eeeeee;
    border-color: #777777;
}

.dark-theme .number-button:hover,
.dark-theme .secondary-button:hover {
    background-color: #333333;
}

.dark-theme .number-button.number-complete {
    background-color: #3a3a3a;
    border-color: #555555;
    color: #888888;
}

.dark-theme .primary-button,
.dark-theme .active-button {
    background-color: #eeeeee;
    color: #111111;
    border-color: #eeeeee;
}

.dark-theme .primary-button:hover {
    background-color: #d8d8d8;
}

.dark-theme .pause-overlay {
    background-color: rgba(0, 0, 0, 0.94);
}

.dark-theme .pause-card {
    background-color: #1f1f1f;
    border-color: #eeeeee;
}

.dark-theme .pause-title {
    color: #eeeeee;
}

.dark-theme .pause-text {
    color: #cccccc;
}
