.game-over-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background-color: #161616;
}

.game-over-card {
    width: 460px;
    max-width: 88%;
    padding: 32px;
    border-radius: 24px;
    background-color: #f4f1ea;
    border-width: 4px;
    border-color: #2b2b2b;
}

.title-label {
    -unity-font-style: bold;
    font-size: 34px;
    color: #1f1f1f;
    -unity-text-align: middle-center;
    margin-bottom: 22px;
    letter-spacing: 2px;
}

.result-label {
    font-size: 18px;
    color: #333333;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.button-group {
    margin-top: 22px;
}

.primary-button,
.secondary-button {
    width: 100%;
    height: 48px;
    margin-bottom: 10px;
    border-radius: 16px;
    -unity-font-style: bold;
    font-size: 16px;
}

.primary-button {
    background-color: #222222;
    color: #ffffff;
    border-width: 2px;
    border-color: #222222;
}

.primary-button:hover {
    background-color: #444444;
}

.secondary-button {
    background-color: #ffffff;
    color: #222222;
    border-width: 2px;
    border-color: #333333;
}

.secondary-button:hover {
    background-color: #e7e2d7;
}